# App
NODE_ENV=development
PORT=4500
CLIENT_URL=http://localhost:3000

# Postgres (Unix socket + peer auth; use user:password@host for TCP)
DATABASE_URL=postgresql://your_user@localhost:5432/stockr_db?host=/var/run/postgresql

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=1d

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx   # printed by `stripe listen`

# Seed (npx prisma db seed)
SEED_ADMIN_EMAIL=admin@stockr.local
SEED_ADMIN_PASSWORD=choose-a-strong-password